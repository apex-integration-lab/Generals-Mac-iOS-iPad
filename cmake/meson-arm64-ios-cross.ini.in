# Meson cross file: build DXVK for iOS (arm64 device or Simulator) on a macOS host.
# The SDK and deployment flag are selected by the CMake iOS preset.
# SDL3 for iOS must be discoverable via PKG_CONFIG_PATH (build/ios/sdl3-install/lib/pkgconfig).

[binaries]
c = 'clang'
cpp = 'clang++'
objc = 'clang'
objcpp = 'clang++'
ar = 'ar'
strip = 'strip'
pkg-config = 'pkg-config'

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'

[built-in options]
c_args = ['-arch', 'arm64', '-isysroot', '@IOS_SDK@', '@IOS_DEPLOYMENT_FLAG@'@DXVK_VULKAN_MESON_INCLUDE_ARGS@]
cpp_args = ['-arch', 'arm64', '-isysroot', '@IOS_SDK@', '@IOS_DEPLOYMENT_FLAG@'@DXVK_VULKAN_MESON_INCLUDE_ARGS@]
c_link_args = ['-arch', 'arm64', '-isysroot', '@IOS_SDK@', '@IOS_DEPLOYMENT_FLAG@']
cpp_link_args = ['-arch', 'arm64', '-isysroot', '@IOS_SDK@', '@IOS_DEPLOYMENT_FLAG@']
