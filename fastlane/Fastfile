# frozen_string_literal: true

default_platform :ios

TEAM_ID      = "LMFTNJ7TE4"
APP_NAME     = "GeneralsXZH"
BUILD_DIR    = "build/ios-vulkan"
IOS_DIR      = "ios"
OUT_DIR      = "build/ios-package"
TESTFLIGHT_INTERNAL_GROUP = "Aaron"

platform :ios do
  private_lane :app_store_connect_key do
    required = %w[
      APP_STORE_CONNECT_API_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_API_KEY_BASE64
    ]
    missing = required.reject { |key| ENV[key] && !ENV[key].empty? }
    UI.user_error!("Missing App Store Connect API-key secrets: #{missing.join(', ')}") unless missing.empty?

    app_store_connect_api_key(
      key_id:                   ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id:                ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content:              ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64:    true,
    )
  end

  private_lane :sync_appstore_signing do |options|
    match(
      type:           "appstore",
      app_identifier: options.fetch(:bundle_id),
      team_id:        TEAM_ID,
      readonly:       true,
    )
  end

  # ── Sync only ─────────────────────────────────────────────────────────────
  desc "Sync App Store distribution cert + provisioning profile via match"
  lane :sync_signing do
    bundle_id = ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh")
    sync_appstore_signing(bundle_id: bundle_id)
  end

  # ── Full build + TestFlight upload ────────────────────────────────────────
  desc "Build engine, package iOS app, upload to TestFlight (no bundled assets)"
  lane :beta do
    Dir.chdir(File.expand_path("..", __dir__)) do
    bundle_id = ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh")
    derived   = "#{IOS_DIR}/build"
    mvk_root  = ENV.fetch("GX_MOLTENVK_ROOT",
                           "#{Dir.home}/GeneralsX/MoltenVK")
    mvk_fw    = "#{mvk_root}/MoltenVK/MoltenVK/dynamic/" \
                "MoltenVK.xcframework/ios-arm64/MoltenVK.framework"

    # 1. Sync App Store distribution cert + provisioning profile
    api_key = app_store_connect_key
    sync_appstore_signing(bundle_id: bundle_id)

    # 2. Build C++ engine for arm64-ios
    sh("cmake --preset ios-vulkan")
    sh("cmake --build #{BUILD_DIR} --target z_generals -j $(sysctl -n hw.ncpu)")

    # 3. Fetch pinned MoltenVK (idempotent)
    sh("GX_MOLTENVK_ROOT=#{mvk_root} scripts/build/ios/fetch-moltenvk.sh")

    # 4. Stage Liberation fonts (renamed to arial/courierNew/timesnewroman)
    sh("scripts/build/ios/stage-fonts.sh")

    # 5. Generate Xcode project + configure manual App Store signing
    sh("cd #{IOS_DIR} && xcodegen generate --quiet")
    increment_build_number(
      xcodeproj: "#{IOS_DIR}/#{APP_NAME}.xcodeproj",
      build_number: ENV.fetch("GX_BUILD_NUMBER"),
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "#{IOS_DIR}/#{APP_NAME}.xcodeproj",
      team_id:               TEAM_ID,
      bundle_identifier:     bundle_id,
      profile_name:          "match AppStore #{bundle_id}",
      code_sign_identity:    "Apple Distribution",
    )

    # 6. Build signing shell app (tiny stub exe, real provisioning profile embedded)
    sh(<<~SH)
      xcodebuild \
        -project #{IOS_DIR}/#{APP_NAME}.xcodeproj \
        -scheme #{APP_NAME} \
        -configuration Release \
        -destination 'generic/platform=iOS' \
        -derivedDataPath #{derived} \
        DEVELOPMENT_TEAM=#{TEAM_ID} \
        PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id} \
        CODE_SIGN_STYLE=Manual \
        PROVISIONING_PROFILE_SPECIFIER="match AppStore #{bundle_id}" \
        build
    SH
    shell_app = "#{derived}/Build/Products/Release-iphoneos/#{APP_NAME}.app"

    # 7. Assemble final .app
    engine_bin = "#{BUILD_DIR}/GeneralsMD/#{APP_NAME}.app/#{APP_NAME}"
    sh("rm -rf #{OUT_DIR} && mkdir -p #{OUT_DIR}")
    sh("cp -R #{shell_app} #{OUT_DIR}/")
    app = "#{OUT_DIR}/#{APP_NAME}.app"

    # Replace stub exe with real engine binary
    sh("cp #{engine_bin} #{app}/#{APP_NAME}")

    # Embed runtime dylibs
    sh("mkdir -p #{app}/Frameworks")
    [
      "#{BUILD_DIR}/_deps/dxvk-build-macos/src/d3d8/libdxvk_d3d8.0.dylib",
      "#{BUILD_DIR}/_deps/dxvk-build-macos/src/d3d9/libdxvk_d3d9.0.dylib",
      "#{BUILD_DIR}/_deps/sdl3-build/libSDL3.0.dylib",
      "#{BUILD_DIR}/_deps/sdl3_image-build/libSDL3_image.0.dylib",
      "#{BUILD_DIR}/_deps/openal_soft-build/libopenal.1.24.2.dylib",
      "#{BUILD_DIR}/libgamespy.dylib",
    ].each do |lib|
      next unless File.exist?(lib)
      sh("cp #{lib} #{app}/Frameworks/")
    end
    # openal install name is libopenal.1.dylib
    sh("mv #{app}/Frameworks/libopenal.1.24.2.dylib "\
       "#{app}/Frameworks/libopenal.1.dylib 2>/dev/null || true")

    # Embed MoltenVK.framework (DXVK dlopens it at runtime)
    UI.user_error!("MoltenVK.framework not found at #{mvk_fw} — "\
                   "run scripts/build/ios/fetch-moltenvk.sh") unless Dir.exist?(mvk_fw)
    sh("cp -R #{mvk_fw} #{app}/Frameworks/MoltenVK.framework")

    # Fix rpath so dylibs resolve from bundle
    sh("install_name_tool -add_rpath @executable_path/Frameworks "\
       "#{app}/#{APP_NAME} 2>/dev/null || true")

    # 8. Re-sign inside-out with App Store distribution identity
    sign_id      = "Apple Distribution"
    entitlements = "#{OUT_DIR}/entitlements.plist"
    sh("codesign -d --entitlements - --xml #{shell_app} > #{entitlements} 2>/dev/null")
    sh("find #{app}/Frameworks -name '*.dylib' "\
       "-exec codesign --force --sign '#{sign_id}' --timestamp=none {} \\;")
    sh("codesign --force --sign '#{sign_id}' --timestamp=none "\
       "#{app}/Frameworks/MoltenVK.framework")
    sh("codesign --force --sign '#{sign_id}' --timestamp=none "\
       "--entitlements #{entitlements} #{app}")
    sh("codesign --verify --deep #{app} && echo '  signature OK'")

    # 9. Wrap .app → .ipa
    ipa = File.expand_path("#{OUT_DIR}/#{APP_NAME}.ipa")
    sh(<<~SH)
      rm -rf /tmp/gx-ipa-build
      mkdir -p /tmp/gx-ipa-build/Payload
      cp -R #{app} /tmp/gx-ipa-build/Payload/
      (cd /tmp/gx-ipa-build && zip -qr '#{ipa}' Payload)
      rm -rf /tmp/gx-ipa-build
    SH

    # 10. Upload to TestFlight
    upload_to_testflight(
      ipa:                             ipa,
      api_key:                         api_key,
      groups:                          [TESTFLIGHT_INTERNAL_GROUP],
      distribute_external:             false,
      skip_waiting_for_build_processing: false,
    )
    end
  end

  desc "Submit a processed TestFlight build to App Store review"
  lane :submit_appstore do
    upload_to_app_store(
      api_key:              app_store_connect_key,
      app_identifier:       ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh"),
      app_version:          ENV.fetch("GX_APP_VERSION", "1.04"),
      build_number:         ENV.fetch("GX_RELEASE_BUILD_NUMBER"),
      skip_binary_upload:   true,
      skip_metadata:        true,
      skip_screenshots:     true,
      submit_for_review:    true,
      automatic_release:    ENV.fetch("GX_AUTOMATIC_RELEASE", "false") == "true",
      force:                true,
    )
  end
end
