# frozen_string_literal: true

require_relative "release_config"
require_relative "upload_auth"

default_platform :ios

TEAM_ID      = "LMFTNJ7TE4"
APP_NAME     = "GeneralsXZH"
APP_STORE_APP_ID = "6798353282"
REPO_ROOT    = File.expand_path("..", __dir__)
BUILD_DIR    = "build/ios-vulkan"
IOS_DIR      = "ios"
OUT_DIR      = "build/ios-package"
TESTFLIGHT_INTERNAL_GROUP = "Aaron"

def match_env_name(bundle_id, suffix)
  ["sigh", bundle_id, "appstore", suffix].join("_")
end

def match_certificate_name(bundle_id)
  ENV.fetch(match_env_name(bundle_id, "certificate-name"), "Apple Distribution")
end

def match_profile_name(bundle_id)
  ENV.fetch(match_env_name(bundle_id, "profile-name"), "match AppStore #{bundle_id}")
end

def validate_ipa_swift_support!(ipa)
  GeneralsXReleaseConfig.validate_ipa_swift_support!(ipa)
rescue GeneralsXReleaseConfig::Error => error
  UI.user_error!(error.message)
end

def validate_archive_dsym!(archive)
  GeneralsXReleaseConfig.validate_archive_dsym!(archive, app_name: APP_NAME)
rescue GeneralsXReleaseConfig::Error => error
  UI.user_error!(error.message)
end

platform :ios do
  private_lane :prepare_release_keychain do
    keychain_name = GeneralsXReleaseConfig.keychain_name
    keychain_password = GeneralsXReleaseConfig.keychain_password
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      lock_after_timeout: false,
      add_to_search_list: true,
    )

    keychain_path = lane_context[SharedValues::KEYCHAIN_PATH]
    keychain_path ||= File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    {
      name: keychain_name,
      password: keychain_password,
      path: keychain_path,
    }
  end

  private_lane :app_store_connect_key do |options|
    if GeneralsXUploadAuth.apple_id_auth?
      if options.fetch(:allow_apple_id_upload, false)
        begin
          GeneralsXUploadAuth.validate_apple_id_upload_env!(
            fallback_apple_id: APP_STORE_APP_ID,
          )
        rescue GeneralsXUploadAuth::Error => error
          UI.user_error!(error.message)
        end
        UI.important(
          "Using Apple ID app-specific password upload; TestFlight processing " \
          "wait and tester group distribution will be skipped.",
        )
        next nil
      end

      UI.user_error!(
        "GX_USE_APPLE_ID_AUTH=true is only supported for TestFlight binary upload. " \
        "App Store review submission requires App Store Connect API-key secrets.",
      )
    end

    app_store_connect_api_key(GeneralsXReleaseConfig.app_store_connect_api_key_options)
  rescue GeneralsXReleaseConfig::Error => error
    UI.user_error!(error.message)
  end

  private_lane :sync_appstore_signing do |options|
    match_options = GeneralsXReleaseConfig.match_options(
      bundle_id: options.fetch(:bundle_id),
      team_id: TEAM_ID,
      keychain_name: options.fetch(:keychain_name),
      keychain_password: options.fetch(:keychain_password),
      api_key: options[:api_key],
    )
    match(match_options)
  end

  # ── Sync only ─────────────────────────────────────────────────────────────
  desc "Sync App Store distribution cert + provisioning profile via match"
  lane :sync_signing do
    bundle_id = ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh")
    keychain = prepare_release_keychain
    sync_appstore_signing(
      bundle_id: bundle_id,
      keychain_name: keychain.fetch(:name),
      keychain_password: keychain.fetch(:password),
    )
  end

  # ── Full build + TestFlight upload ────────────────────────────────────────
  desc "Build engine, package iOS app, upload to TestFlight (no bundled assets)"
  lane :beta do
    GeneralsXReleaseConfig.apply_ios_build_defaults!
    bundle_id = ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh")
    api_key = app_store_connect_key(allow_apple_id_upload: true)
    keychain = prepare_release_keychain
    sync_appstore_signing(
      bundle_id: bundle_id,
      keychain_name: keychain.fetch(:name),
      keychain_password: keychain.fetch(:password),
      api_key: api_key,
    )

    Dir.chdir(REPO_ROOT) do
      xcodeproj = File.join(REPO_ROOT, IOS_DIR, "#{APP_NAME}.xcodeproj")
      derived   = "#{IOS_DIR}/build"
      mvk_root  = ENV.fetch("GX_MOLTENVK_ROOT",
                             "#{Dir.home}/GeneralsX/MoltenVK")
      mvk_fw    = "#{mvk_root}/MoltenVK/MoltenVK/dynamic/" \
                  "MoltenVK.xcframework/ios-arm64/MoltenVK.framework"
      profile_name = match_profile_name(bundle_id)
      certificate_name = match_certificate_name(bundle_id)

      # 1. Build C++ engine for arm64-ios
      sh("cmake --preset ios-vulkan "\
         "-DCMAKE_C_COMPILER_LAUNCHER=ccache "\
         "-DCMAKE_CXX_COMPILER_LAUNCHER=ccache")
      sh("cmake --build #{BUILD_DIR} --target z_generals -j $(sysctl -n hw.ncpu)")

      # 2. Fetch pinned MoltenVK (idempotent)
      sh("GX_MOLTENVK_ROOT=#{mvk_root} scripts/build/ios/fetch-moltenvk.sh")

      # 3. Stage Liberation fonts (renamed to arial/courierNew/timesnewroman)
      sh("scripts/build/ios/stage-fonts.sh")

      # 4. Generate Xcode project + configure manual App Store signing
      sh("cd #{IOS_DIR} && xcodegen generate --quiet")
      UI.user_error!("Xcode project not generated at #{xcodeproj}") unless Dir.exist?(xcodeproj)
      increment_build_number(
        xcodeproj: xcodeproj,
        build_number: ENV.fetch("GX_BUILD_NUMBER"),
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path:                  xcodeproj,
        team_id:               TEAM_ID,
        bundle_identifier:     bundle_id,
        profile_name:          profile_name,
        code_sign_identity:    certificate_name,
      )

      # 5. Archive and export with Xcode/Fastlane so IPA metadata is App Store-ready.
      UI.user_error!("MoltenVK.framework not found at #{mvk_fw} — "\
                     "run scripts/build/ios/fetch-moltenvk.sh") unless Dir.exist?(mvk_fw)
      ENV["GX_CMAKE_BUILD_DIR"] = File.expand_path(BUILD_DIR)
      ENV["GX_MOLTENVK_ROOT"] = mvk_root
      build_app(
        GeneralsXReleaseConfig.build_app_options(
          app_name: APP_NAME,
          xcodeproj: xcodeproj,
          derived_data_path: derived,
          out_dir: OUT_DIR,
          bundle_id: bundle_id,
          team_id: TEAM_ID,
          profile_name: profile_name,
          certificate_name: certificate_name,
          keychain_path: keychain.fetch(:path),
        ),
      )
      archive = File.expand_path("#{OUT_DIR}/#{APP_NAME}.xcarchive")
      validate_archive_dsym!(archive)
      ipa = File.expand_path("#{OUT_DIR}/#{APP_NAME}.ipa")
      UI.user_error!("Fastlane did not export IPA at #{ipa}") unless File.file?(ipa)
      # GeneralsX @build Codex 06/08/2026 Fail before upload if App Store SwiftSupport is missing.
      validate_ipa_swift_support!(ipa)

      # 6. Upload to TestFlight
      base_upload_options = GeneralsXReleaseConfig.testflight_upload_options(
        ipa: ipa,
        default_group: TESTFLIGHT_INTERNAL_GROUP,
      )
      upload_options = if api_key
        base_upload_options.merge(api_key: api_key)
      else
        GeneralsXUploadAuth.apple_id_upload_options(
          base_upload_options,
          bundle_id: bundle_id,
          fallback_apple_id: APP_STORE_APP_ID,
        )
      end
      upload_to_testflight(upload_options)
    end
  end

  desc "Submit a processed TestFlight build to App Store review"
  lane :submit_appstore do
    api_key = app_store_connect_key
    upload_options = {
      app_identifier:       ENV.fetch("GX_BUNDLE_ID", "com.aaron.generalszh"),
      app_version:          ENV.fetch("GX_APP_VERSION", "1.04"),
      build_number:         ENV.fetch("GX_RELEASE_BUILD_NUMBER"),
      skip_binary_upload:   true,
      skip_metadata:        true,
      skip_screenshots:     true,
      submit_for_review:    true,
      automatic_release:    ENV.fetch("GX_AUTOMATIC_RELEASE", "false") == "true",
      force:                true,
    }
    upload_options[:api_key] = api_key if api_key
    upload_to_app_store(upload_options)
  end
end
