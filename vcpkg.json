{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "builtin-baseline": "8f57207a8a1b96a4a864e11f85d57b0a252b3ac3",
    "dependencies": [
      "zlib",
      "glm",
      "gli",
      {
        "name": "freetype",
        "platform": "!windows"
      },
      {
        "name": "fontconfig",
        "platform": "!windows & !ios"
      },
      {
        "name": "openal-soft",
        "platform": "!windows",
        "features": []
      },
      {
        "name": "curl",
        "platform": "!windows",
        "features": ["ssl"]
      },
      {
        "name": "ffmpeg",
        "platform": "ios",
        "features": ["avcodec", "avformat", "swscale", "swresample"]
      }
    ],
    "overrides": [
      {
        "name": "ffmpeg",
        "version": "8.1.1",
        "port-version": 2
      },
      {
        "name": "ffmpeg-bin2c",
        "version": "8.1.1"
      }
    ]
  }
